<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark card background for the home-screen widget, with a purple
     accent stroke tying it to the app's Material 3 theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1F1B24" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#6750A4" />
</shape>
